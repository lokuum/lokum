{
  "name": "lokum",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "scraper",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "scrape": "npm run scrape --workspace scraper",
    "scrape:dolnoslaskie": "npm run scrape --workspace scraper -- --voivodeship dolnoslaskie",
    "scrape:kujawsko-pomorskie": "npm run scrape --workspace scraper -- --voivodeship kujawsko-pomorskie",
    "scrape:lubelskie": "npm run scrape --workspace scraper -- --voivodeship lubelskie",
    "scrape:lubuskie": "npm run scrape --workspace scraper -- --voivodeship lubuskie",
    "scrape:lodzkie": "npm run scrape --workspace scraper -- --voivodeship lodzkie",
    "scrape:malopolskie": "npm run scrape --workspace scraper -- --voivodeship malopolskie",
    "scrape:mazowieckie": "npm run scrape --workspace scraper -- --voivodeship mazowieckie",
    "scrape:opolskie": "npm run scrape --workspace scraper -- --voivodeship opolskie",
    "scrape:podkarpackie": "npm run scrape --workspace scraper -- --voivodeship podkarpackie",
    "scrape:podlaskie": "npm run scrape --workspace scraper -- --voivodeship podlaskie",
    "scrape:pomorskie": "npm run scrape --workspace scraper -- --voivodeship pomorskie",
    "scrape:slaskie": "npm run scrape --workspace scraper -- --voivodeship slaskie",
    "scrape:swietokrzyskie": "npm run scrape --workspace scraper -- --voivodeship swietokrzyskie",
    "scrape:warminsko-mazurskie": "npm run scrape --workspace scraper -- --voivodeship warminsko-mazurskie",
    "scrape:wielkopolskie": "npm run scrape --workspace scraper -- --voivodeship wielkopolskie",
    "scrape:zachodniopomorskie": "npm run scrape --workspace scraper -- --voivodeship zachodniopomorskie",
    "scrape:summary": "npm run scrape --workspace scraper -- --summary-only",
    "fix:geo": "npm run fix:geo --workspace scraper",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.5"
  }
}
